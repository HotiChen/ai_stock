# ── Anthropic API ─────────────────────────────────────────────────────────────
# 取得：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Shioaji（永豐金 API）─────────────────────────────────────────────────────
# 取得：https://sinotrade.github.io/
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here
SHIOAJI_SIMULATION=true          # true=Shioaji 模擬報價, false=真實市場報價
PAPER_TRADING=true               # true=模擬下單（不送券商）, false=真實下單 ⚠️
                                  # 建議：SHIOAJI_SIMULATION=false + PAPER_TRADING=true
                                  # → 看真實報價，但不會真的下單

# ── Telegram 通知 ─────────────────────────────────────────────────────────────
# Bot Token 從 @BotFather 取得；Chat ID 從 @userinfobot 取得
TELEGRAM_BOT_TOKEN=1234567890:AAE...
TELEGRAM_CHAT_ID=123456789

# ── 交易參數 ──────────────────────────────────────────────────────────────────
BUDGET=100000                    # 可用資金（新台幣）
ORDER_HARD_LIMIT=150000          # 單筆委託金額上限（新台幣）

# ── 資料庫 ────────────────────────────────────────────────────────────────────
DB_PATH=data/research.db
DB_ENCRYPTION_KEY=               # 選填，加密金鑰

# ── 監控 ──────────────────────────────────────────────────────────────────────
MONITOR_POLL_SECONDS=30          # Shioaji snapshot 輪詢間隔（秒）
