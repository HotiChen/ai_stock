# ── Anthropic API ─────────────────────────────────────────────────────────────
# 取得：https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Shioaji（永豐金 API）─────────────────────────────────────────────────────
# 取得：https://sinotrade.github.io/
SHIOAJI_API_KEY=your_api_key_here
SHIOAJI_SECRET_KEY=your_secret_key_here
SHIOAJI_SIMULATION=true          # true=Shioaji 模擬報價, false=真實市場報價
PAPER_TRADING=true               # true=模擬下單（不送券商）, false=真實下單 ⚠️
                                  # 建議：SHIOAJI_SIMULATION=false + PAPER_TRADING=true
                                  # → 看真實報價，但不會真的下單

# ── Telegram 通知 ─────────────────────────────────────────────────────────────
# Bot Token 從 @BotFather 取得；Chat ID 從 @userinfobot 取得
TELEGRAM_BOT_TOKEN=1234567890:AAE...
TELEGRAM_CHAT_ID=123456789

# ── 交易參數 ──────────────────────────────────────────────────────────────────
BUDGET=100000                    # 可用資金（新台幣）
ORDER_HARD_LIMIT=150000          # 單筆委託金額上限（新台幣）

# ── 資料庫 ────────────────────────────────────────────────────────────────────
DB_PATH=data/research.db
DB_ENCRYPTION_KEY=               # 選填，加密金鑰

# ── 監控 ──────────────────────────────────────────────────────────────────────
MONITOR_POLL_SECONDS=30          # Shioaji snapshot 輪詢間隔（秒）

# ── Backend（FastAPI）─────────────────────────────────────────────────────────
SECRET_KEY=                      # JWT 簽章密鑰（未設定時每次啟動隨機產生，token 重啟即失效）
USER_EMAIL=admin@quant.ai        # 登入帳號
USER_PASSWORD_HASH=              # bcrypt 雜湊（建議）；或用 USER_PASSWORD 明文（啟動時雜湊）
CORS_ORIGINS=http://localhost:5173   # 逗號分隔的允許來源
BACKEND_URL=http://127.0.0.1:8000    # telegram_bot 回寫下單確認的 backend 位址
BACKEND_INTERNAL_TOKEN=          # telegram_bot ↔ backend 內部共享密鑰（未設定=橋接停用）
ORDER_CONFIRM_TIMEOUT_SECONDS=60     # 下單 Telegram 確認逾時（秒）

# ── 本地 LLM（選用，新聞預過濾）──────────────────────────────────────────────
LOCAL_LLM_BASE_URL=              # 設定後啟用，如 http://localhost:11434/v1（Ollama）
LOCAL_LLM_MODEL=gemma3:12b       # 模型名稱
LOCAL_LLM_TIMEOUT=30             # 逾時（秒）

# ── 研究迴圈（Playbook）──────────────────────────────────────────────────────
PLAYBOOK_PATH=research_playbook.md   # Gemini 研究作業手冊位置
PLAYBOOK_UPDATE_ENABLED=true         # 13:50 盤後自動更新自適應區
